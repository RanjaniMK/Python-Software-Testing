    "global sum \n",
    "def calculate_average(*numbers):\n",
    "    sum=0\n",
    "    for number in numbers:\n",
    "        sum+=number\n",
    "        number_of_values=len(numbers)\n",
    "        average=sum/number_of_values\n",
    "    return average\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "calculate_average(2,10,99,100)\n",
    "\n",
    "\n"
   ]
  }
